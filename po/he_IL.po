#: trelby/commands.py:121
msgid "Abort something, e.g. selection, auto-completion, etc."
msgstr "ביטול פעולה, למשל בחירה, השלמה אוטומטית וכו׳."

#: trelby/commands.py:125
msgid "Show the about dialog."
msgstr "הצג את חלון האודות."

#: trelby/commands.py:128
msgid "Open the auto-completion dialog."
msgstr "פתח את חלון ההשלמה האוטומטית."

#: trelby/commands.py:133
msgid "Change current element's style to act break."
msgstr "שנה את סוג הרכיב הנוכחי לסוף מערכה."

#: trelby/commands.py:138
msgid "Change current element's style to action."
msgstr "שנה את סוג הרכיב הנוכחי לתיאור."

#: trelby/commands.py:143
msgid "Change current element's style to character."
msgstr "שנה את סוג הרכיב הנוכחי לדמות."

#: trelby/commands.py:148
msgid "Change current element's style to dialogue."
msgstr "שנה את סוג הרכיב הנוכחי לדיאלוג."

#: trelby/commands.py:153
msgid "Change current element's style to note."
msgstr "שנה את סוג הרכיב הנוכחי להערה."

#: trelby/commands.py:158
msgid "Change current element's style to parenthetical."
msgstr "שנה את סוג הרכיב הנוכחי להוראת משחק."

#: trelby/commands.py:163
msgid "Change current element's style to scene."
msgstr "שנה את סוג הרכיב הנוכחי לכותרת סצנה."

#: trelby/commands.py:166
msgid "Change current element's style to shot."
msgstr "שנה את סוג הרכיב הנוכחי לשוט."

#: trelby/commands.py:169
msgid "Change current element's style to transition."
msgstr "שנה את סוג הרכיב הנוכחי למעבר."

#: trelby/commands.py:172
msgid "Open the character map."
msgstr "פתח את מפת התווים."

#: trelby/commands.py:175
msgid "Open the character profiles dialog."
msgstr "פתח את חלון פרופילי הדמויות."

#: trelby/commands.py:180
msgid "Check the current script for formatting errors."
msgstr "בדוק את התסריט הנוכחי לאיתור שגיאות עיצוב."

#: trelby/commands.py:186
msgid "Close the current script."
msgstr "סגור את התסריט הנוכחי."

#: trelby/commands.py:191
msgid "Compare two scripts."
msgstr "השווה בין שני תסריטים."

#: trelby/commands.py:194
msgid "Copy selected text to the internal clipboard."
msgstr "העתק את הטקסט הנבחר ללוח הפנימי."

#: trelby/commands.py:201
msgid "Copy selected text to the system's clipboard, unformatted."
msgstr "העתק את הטקסט הנבחר ללוח המערכת, ללא עיצוב."

#: trelby/commands.py:206
msgid "Copy selected text to the system's clipboard, formatted."
msgstr "העתק את הטקסט הנבחר ללוח המערכת, עם עיצוב."

#: trelby/commands.py:211
msgid "Cut selected text to internal clipboard."
msgstr "גזור את הטקסט הנבחר ללוח הפנימי."

#: trelby/commands.py:218
msgid "Delete the character under the cursor, or selected text."
msgstr "מחק את התו שתחת הסמן, או את הטקסט הנבחר."

#: trelby/commands.py:224
msgid "Delete the character behind the cursor."
msgstr "מחק את התו שלפני הסמן."

#: trelby/commands.py:230
msgid "Open the 'Delete elements' dialog."
msgstr "פתח את החלון 'מחיקת רכיבים'."

#: trelby/commands.py:236
msgid ""
"Turn dual dialogue on or off for the current speech and the one before it."
msgstr "הפעל או בטל דיאלוג כפול עבור הדיבור הנוכחי והדיבור שלפניו."

#: trelby/commands.py:242
msgid "Export the current script."
msgstr "ייצא את התסריט הנוכחי."

#: trelby/commands.py:245
msgid "Open the 'Find & Replace' dialog."
msgstr "פתח את החלון 'חיפוש והחלפה'."

#: trelby/commands.py:250
msgid "Open the page footer dialog."
msgstr "פתח את חלון הכותרת התחתונה."

#: trelby/commands.py:253
msgid "Insert a forced line break."
msgstr "הוסף מעבר שורה כפוי."

#: trelby/commands.py:264
msgid "Toggle fullscreen."
msgstr "הפעל או בטל מסך מלא."

#: trelby/commands.py:271
msgid "Goto to a given page."
msgstr "עבור לעמוד מסוים."

#: trelby/commands.py:278
msgid "Goto to a given scene."
msgstr "עבור לסצנה מסוימת."

#: trelby/commands.py:283
msgid "Open the headers dialog."
msgstr "פתח את חלון הכותרות העליונות."

#: trelby/commands.py:286
msgid "Show list of commands and their key bindings."
msgstr "הצג את רשימת הפקודות וקיצורי המקשים שלהן."

#: trelby/commands.py:289
msgid "Open the manual."
msgstr "פתח את המדריך."

#: trelby/commands.py:290
msgid "Import a script."
msgstr "ייבא תסריט."

#: trelby/commands.py:293
msgid "Insert non-breaking space."
msgstr "הוסף רווח קשיח."

#: trelby/commands.py:299
msgid "Load script-specific settings."
msgstr "טען הגדרות תסריט."

#: trelby/commands.py:302
msgid "Load global settings."
msgstr "טען הגדרות כלליות."

#: trelby/commands.py:303
msgid "Open the locations dialog."
msgstr "פתח את חלון המיקומים."

#: trelby/commands.py:306
msgid "Move down."
msgstr "זוז למטה."

#: trelby/commands.py:313
msgid "Move to the end of the line or finish auto-completion."
msgstr "זוז לסוף השורה או השלם את ההשלמה האוטומטית."

#: trelby/commands.py:319
msgid "Move to the end of the script."
msgstr "זוז לסוף התסריט."

#: trelby/commands.py:323
msgid "Move left."
msgstr "זוז שמאלה."

#: trelby/commands.py:326
msgid "Move to start of next word."
msgstr "זוז לתחילת המילה הבאה."

#: trelby/commands.py:333
msgid "Move one page down."
msgstr "זוז עמוד אחד למטה."

#: trelby/commands.py:339
msgid "Move one page up."
msgstr "זוז עמוד אחד למעלה."

#: trelby/commands.py:345
msgid "Move to start of previous word."
msgstr "זוז לתחילת המילה הקודמת."

#: trelby/commands.py:350
msgid "Move right."
msgstr "זוז ימינה."

#: trelby/commands.py:353
msgid "Move one scene down."
msgstr "זוז סצנה אחת למטה."

#: trelby/commands.py:359
msgid "Move one scene up."
msgstr "זוז סצנה אחת למעלה."

#: trelby/commands.py:365
msgid "Move to the start of the line."
msgstr "זוז לתחילת השורה."

#: trelby/commands.py:371
msgid "Move to the start of the script."
msgstr "זוז לתחילת התסריט."

#: trelby/commands.py:377
msgid "Move up."
msgstr "זוז למעלה."

#: trelby/commands.py:383
msgid "Open the character name database."
msgstr "פתח את מאגר שמות הדמויות."

#: trelby/commands.py:387
msgid "Create a new element."
msgstr "צור רכיב חדש."

#: trelby/commands.py:393
msgid "Create a new script."
msgstr "צור תסריט חדש."

#: trelby/commands.py:400
msgid "Open a script."
msgstr "פתח תסריט."

#: trelby/commands.py:407
msgid "Paste text from the internal clipboard."
msgstr "הדבק טקסט מהלוח הפנימי."

#: trelby/commands.py:414
msgid "Paste text from the system's clipboard."
msgstr "הדבק טקסט מלוח המערכת."

#: trelby/commands.py:419
msgid "Print current script."
msgstr "הדפס את התסריט הנוכחי."

#: trelby/commands.py:426
msgid "Quit the program."
msgstr "צא מהתוכנה."

#: trelby/commands.py:433
msgid "Redo a change that was reverted through undo."
msgstr "בצע שוב שינוי שבוטל."

#: trelby/commands.py:439
msgid "Generate character report."
msgstr "צור דוח דמויות."

#: trelby/commands.py:443
msgid "Generate dialogue chart report."
msgstr "צור תרשים דיאלוגים."

#: trelby/commands.py:446
msgid "Generate location report."
msgstr "צור דוח מיקומים."

#: trelby/commands.py:447
msgid "Generate scene report."
msgstr "צור דוח סצנות."

#: trelby/commands.py:448
msgid "Generate script report."
msgstr "צור דוח תסריט."

#: trelby/commands.py:451
msgid "Revert current script to the version on disk."
msgstr "החזר את התסריט הנוכחי לגרסה השמורה בדיסק."

#: trelby/commands.py:456
msgid "Save the current script."
msgstr "שמור את התסריט הנוכחי."

#: trelby/commands.py:463
msgid "Save the current script to a new file."
msgstr "שמור את התסריט הנוכחי בקובץ חדש."

#: trelby/commands.py:468
msgid "Save script-specific settings to a new file."
msgstr "שמור את הגדרות התסריט בקובץ חדש."

#: trelby/commands.py:473
msgid "Save global settings to a new file."
msgstr "שמור את ההגדרות הכלליות בקובץ חדש."

#: trelby/commands.py:478
msgid "Change to next open script."
msgstr "עבור לתסריט הפתוח הבא."

#: trelby/commands.py:487
msgid "Change to previous open script."
msgstr "עבור לתסריט הפתוח הקודם."

#: trelby/commands.py:495
msgid "Change script-specific settings."
msgstr "שנה את הגדרות התסריט."

#: trelby/commands.py:497
msgid "Select the entire script."
msgstr "בחר את כל התסריט."

#: trelby/commands.py:500
msgid "Select the current scene."
msgstr "בחר את הסצנה הנוכחית."

#: trelby/commands.py:506
msgid "Set mark at current cursor position."
msgstr "הצב סימון במיקום הסמן הנוכחי."

#: trelby/commands.py:509
msgid "Change global settings."
msgstr "שנה הגדרות כלליות."

#: trelby/commands.py:512
msgid "Open the global spell checker dictionary dialog."
msgstr "פתח את חלון המילון הכללי של בודק האיות."

#: trelby/commands.py:517
msgid "Spell check the script."
msgstr "בדוק איות בתסריט."

#: trelby/commands.py:523
msgid "Open the script-specific spell checker dictionary dialog."
msgstr "פתח את חלון מילון התסריט של בודק האיות."

#: trelby/commands.py:529
msgid "Change current element to the next style or create a new element."
msgstr "שנה את הרכיב הנוכחי לסוג הבא או צור רכיב חדש."

#: trelby/commands.py:536
msgid "Change current element to the previous style."
msgstr "שנה את הרכיב הנוכחי לסוג הקודם."

#: trelby/commands.py:540
msgid "Open the titles dialog."
msgstr "פתח את חלון דפי השער."

#: trelby/commands.py:543
msgid "Switch between the script and its beat board."
msgstr "עבור בין התסריט ללוח הביטים שלו."

#: trelby/commands.py:548
msgid "Make the selected text, or the text typed next, bold or not."
msgstr "הפעל או בטל הדגשה בטקסט הנבחר, או בטקסט שיוקלד בהמשך."

#: trelby/commands.py:554
msgid "Center the current action element, or stop centering it."
msgstr "מרכז את רכיב התיאור הנוכחי, או הפסק למרכז אותו."

#: trelby/commands.py:560
msgid "Make the selected text, or the text typed next, italic or not."
msgstr "הפעל או בטל הטיה בטקסט הנבחר, או בטקסט שיוקלד בהמשך."

#: trelby/commands.py:570
msgid "Show or hide the outline view."
msgstr "הצג או הסתר את תצוגת המתווה."

#: trelby/commands.py:575
msgid "Toggle 'Show formatting' display."
msgstr "הפעל או בטל את התצוגה 'הצג עיצוב'."

#: trelby/commands.py:581
msgid "Make the selected text, or the text typed next, underlined or not."
msgstr "הוסף או הסר קו תחתון בטקסט הנבחר, או בטקסט שיוקלד בהמשך."

#: trelby/commands.py:589
msgid "Undo the last change."
msgstr "בטל את השינוי האחרון."

#: trelby/commands.py:595
msgid "Change view mode to continuous."
msgstr "שנה את מצב התצוגה לרציף."

#: trelby/commands.py:598
msgid "Change view mode to page."
msgstr "שנה את מצב התצוגה לעמודים."

#: trelby/commands.py:602
msgid "Change view mode to side by side."
msgstr "שנה את מצב התצוגה לזה לצד זה."

#: trelby/commands.py:605
msgid "Export the current script as watermarked PDFs."
msgstr "ייצא את התסריט הנוכחי כקובצי PDF עם סימני מים."

#: trelby/commands.py:608
msgid "Open the world building dialog."
msgstr "פתח את חלון בניית העולם."

#: trelby/commands.py:613
msgid "Zoom in."
msgstr "הגדל תצוגה."

#: trelby/commands.py:620
msgid "Zoom out."
msgstr "הקטן תצוגה."

#: trelby/commands.py:627
msgid "Reset zoom to 100%."
msgstr "אפס את התצוגה ל־100%."

